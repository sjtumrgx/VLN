# 模型配置
MODEL_PATH=/data1/Qwen3VL/models--Qwen--Qwen3-VL-8B-Instruct
# 可选30B模型：/data1/Qwen3VL/models--Qwen--Qwen3-VL-30B-A3B-Instruct
DEFAULT_MODEL=qwen3-vl-8b

# 服务配置
VLLM_API_URL=http://localhost:8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# Redis配置
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# SQLite配置
SQLITE_DB_PATH=./data/vln.db

# 性能配置
VIDEO_INFERENCE_FPS=10
VIDEO_STREAM_RESOLUTION_WIDTH=640
VIDEO_STREAM_RESOLUTION_HEIGHT=480
FRAME_SKIP_RATIO=3
WEBSOCKET_MAX_QUEUE_SIZE=5
GPU_MEMORY_UTILIZATION=0.95
TENSOR_PARALLEL_SIZE=4

# 路径规划配置
NUM_WAYPOINTS=12
MAX_LINEAR_VELOCITY=1.0
MAX_ANGULAR_VELOCITY=1.57

# 记忆配置
MEMORY_WINDOW_SIZE=10
MEMORY_SUMMARY_LENGTH=5
